# Root .htaccess untuk Shared Hosting (cPanel / DirectAdmin / Plesk)
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -Indexes
    </IfModule>

    RewriteEngine On

    # Keamanan: Blokir akses HTTP langsung ke file & folder sensitif Laravel
    RewriteRule ^(\.env|\.git|\.editorconfig|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|README\.md|artisan) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    # Alihkan seluruh request web publik ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
